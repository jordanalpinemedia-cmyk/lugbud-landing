# Resend API key, used by api/waitlist.js to create contacts.
#
# Create one at https://resend.com/api-keys with **Full access**.
# "Sending access" is not enough — it only permits sending email, and adding a
# contact is not a send.
#
# Local:      copy to .env.local and run `vercel dev`
#             (plain `vite dev` does not run serverless functions)
# Production: Vercel dashboard > Settings > Environment Variables
RESEND_API_KEY=re_your_key_here

# Strava OAuth application (https://www.strava.com/settings/api).
# Authorization Callback Domain must be the bare host, e.g. lugbud-landing.vercel.app
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Shared secret echoed back during the Strava webhook subscription handshake.
# Any long random string; must match the verify_token used to create the sub.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Strava caps connected athletes: 1 for a new app, 10 after self-upgrade,
# more only after review. /api/strava/start refuses past this rather than
# dumping visitors on a Strava error page.
STRAVA_ATHLETE_CAP=10

# Provisioned automatically by the Neon Marketplace integration.
DATABASE_URL=
