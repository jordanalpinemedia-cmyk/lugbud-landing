# dependencies
node_modules

# build output
dist
.vite

# vercel
.vercel

# logs
*.log
npm-debug.log*

# secrets — never commit real keys.
# Broad glob so a stray .env.production or .env.staging can't slip through;
# the checked-in template is the one deliberate exception.
.env*
!.env.example

# local + editor
.DS_Store
*.local

# agent tooling installed by integrations (machine-local, not project source).
# Scoped to .claude/skills so the tracked .claude/launch.json survives.
.agents
.claude/skills
skills-lock.json
